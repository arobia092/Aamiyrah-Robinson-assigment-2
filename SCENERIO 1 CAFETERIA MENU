
 //SCENERIO 1(CAFETERIA MENU)

#include <iostream> 
#include <vector> 
#include <string>
  
using namespace std;

int main(){
    vector<string> menu;
    // adding 5 dishes using push_back
    menu.push_back("steak");
    menu.push_back("rice");
    menu.push_back("mashpotatoe");
    menu.push_back("cabbage");
    menu.push_back("water");

    //inserting a new dish at the 2nd position 
    menu.insert(menu.begin() + 1,"chicken");
    
    //removing the 4th dish option .erase
    menu.erase(menu.begin() + 4);
   
    // range based loop for printing final menu options
    for (string food : menu) {
        cout << food << " ";
}
    

    
    return 0;
}
